DATABASE_URL=sqlite+pysqlite:///./hiring_ai.db
AUTH_MODE=dev
ENVIRONMENT=development
SEED_DEMO_TENANT=true
CORS_ORIGINS=http://127.0.0.1:5177,http://localhost:5177
OAUTH_REDIRECT_URL=http://127.0.0.1:5177/auth/callback
INVITE_CODE_PEPPER=hiring-ai-invite-dev-pepper
GITHUB_TOKEN=
TALENT_SOURCING_PROVIDER=github

# Groq AI (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Hosted (staging/production) — required by production guards. Do not use SQLite.
