# Celestra Core — environment template
CELESTRA_ENV=development
CELESTRA_APP_NAME=celestra-core
CELESTRA_DEBUG=true
CELESTRA_API_PREFIX=/api/v1
CELESTRA_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Auth / JWT
CELESTRA_JWT_ALGORITHM=HS256
CELESTRA_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
CELESTRA_JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
CELESTRA_AUTH_ALLOW_REGISTRATION=true
CELESTRA_AUTH_DEFAULT_ROLE=member

# Monitoring
CELESTRA_METRICS_ENABLED=true
CELESTRA_METRICS_NAMESPACE=celestra

# AI / Providers (Phase 3)
CELESTRA_AI_DEFAULT_PROVIDER=mock
CELESTRA_AI_DEFAULT_MODEL=mock-chat
CELESTRA_AI_TIMEOUT_SECONDS=60
CELESTRA_AI_MAX_RETRIES=2
CELESTRA_OPENAI_API_KEY=
CELESTRA_OPENAI_BASE_URL=https://api.openai.com/v1
CELESTRA_OPENAI_DEFAULT_MODEL=gpt-4o-mini
CELESTRA_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CELESTRA_ANTHROPIC_API_KEY=
CELESTRA_ANTHROPIC_BASE_URL=https://api.anthropic.com
CELESTRA_ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# Memory / Agents / Workflows (Phase 4)
CELESTRA_MEMORY_WINDOW_SIZE=20
CELESTRA_AGENT_MAX_STEPS_DEFAULT=5
CELESTRA_WORKFLOW_CELERY_ENABLED=false

# Storage / Notifications / Knowledge (Phase 5)
CELESTRA_STORAGE_BACKEND=local
CELESTRA_STORAGE_LOCAL_PATH=.data/storage
CELESTRA_STORAGE_BUCKET=celestra
CELESTRA_S3_ENDPOINT_URL=
CELESTRA_S3_ACCESS_KEY=
CELESTRA_S3_SECRET_KEY=
CELESTRA_S3_REGION=us-east-1
CELESTRA_KNOWLEDGE_CHUNK_SIZE=800
CELESTRA_KNOWLEDGE_CHUNK_OVERLAP=100

# Billing / Analytics (Phase 6)
CELESTRA_BILLING_DEFAULT_PLAN=free

# Production hardening (Phase 7)
CELESTRA_MEMORY_CONVERSATION_BACKEND=memory
CELESTRA_MEMORY_CONVERSATION_TTL_SECONDS=604800
CELESTRA_MEMORY_VECTOR_BACKEND=memory
CELESTRA_WORKFLOW_RUN_BACKEND=memory
CELESTRA_WORKFLOW_RUN_TTL_SECONDS=2592000
CELESTRA_SMTP_HOST=
CELESTRA_SMTP_PORT=587
CELESTRA_SMTP_USERNAME=
CELESTRA_SMTP_PASSWORD=
CELESTRA_SMTP_FROM=
CELESTRA_SMTP_USE_TLS=true
CELESTRA_STRIPE_SECRET_KEY=
CELESTRA_STRIPE_PRICE_MAP=
CELESTRA_OIDC_ISSUER=
CELESTRA_OIDC_CLIENT_ID=
CELESTRA_OIDC_CLIENT_SECRET=
CELESTRA_OIDC_REDIRECT_URI=
CELESTRA_OIDC_SCOPES=openid,profile,email

CELESTRA_HOST=0.0.0.0
CELESTRA_PORT=8000
CELESTRA_WORKERS=1
CELESTRA_DATABASE_URL=postgresql+asyncpg://celestra:celestra@localhost:5432/celestra_core
CELESTRA_DATABASE_URL_SYNC=postgresql+psycopg2://celestra:celestra@localhost:5432/celestra_core
CELESTRA_DB_POOL_SIZE=5
CELESTRA_DB_MAX_OVERFLOW=10
CELESTRA_DB_ECHO=false
CELESTRA_REDIS_URL=redis://localhost:6379/0
CELESTRA_REDIS_PREFIX=celestra:
CELESTRA_CACHE_DEFAULT_TTL=300
CELESTRA_LOCK_DEFAULT_TTL=30
CELESTRA_CELERY_BROKER_URL=redis://localhost:6379/1
CELESTRA_CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELESTRA_LOG_LEVEL=INFO
CELESTRA_LOG_JSON=true
CELESTRA_LOG_REQUESTS=true
CELESTRA_LOG_PERFORMANCE=true
CELESTRA_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
