APP_NAME=Hiring AI
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# REQUIRED in production — generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ALGORITHM=HS256

DATABASE_URL=postgresql+psycopg://hiring:hiring@localhost:5432/hiring_ai
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT=120/minute

MAX_UPLOAD_SIZE_MB=10
ALLOWED_RESUME_EXTENSIONS=pdf,doc,docx
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=hiring-ai
S3_REGION=us-east-1

CACHE_TTL_SECONDS=3600
AI_PROVIDER=mock
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=4096
AI_MAX_RETRIES=2

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

INTELLIGENCE_CACHE_TTL_SECONDS=86400
INTELLIGENCE_PROVIDER_TIMEOUT_SECONDS=20
INTELLIGENCE_MAX_CONCURRENCY=8
INTELLIGENCE_ENABLE_SIMULATED=true

FRONTEND_URL=http://localhost:5173
SMTP_ENABLED=false

# Live intelligence adapters (optional)
# When unset, providers try public sources (GDELT, Wikipedia, website crawl)
# and fall back to tagged simulation if INTELLIGENCE_ENABLE_SIMULATED=true
NEWS_API_KEY=
BUILTWITH_API_KEY=
CLEARBIT_API_KEY=

INTELLIGENCE_LIVE_ENABLED=true
